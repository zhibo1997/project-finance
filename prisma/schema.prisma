generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 项目表
model projects {
  id                  String    @id @default(uuid())
  project_name        String
  project_leader      String
  client_name         String?
  project_type        String?
  service_start_date  DateTime?
  service_end_date    DateTime?
  service_amount      Decimal?
  status              String    @default("draft")
  form_data           String?
  created_by          String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  project_members     project_members[]
  accounting_records  accounting_records[]

  @@index([status])
  @@index([project_leader])
  @@index([created_at], map: "idx_created")
}

// 项目成员表
model project_members {
  id          String    @id @default(uuid())
  project_id  String
  user_id     String
  user_name   String?
  role        String    @default("member")
  created_at  DateTime  @default(now())

  project     projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id], map: "uk_project_user")
}

// 记账表
model accounting_records {
  id                  String    @id @default(uuid())
  project_id          String
  record_type         String
  approval_id         String
  record_date         DateTime
  amount              Decimal
  category_id         String?
  description         String?
  applicant           String?
  invoice_no          String?
  payer               String?
  attachments         String?
  remark              String?
  created_by          String
  created_by_name     String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  project             projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([record_type])
  @@index([record_date])
}

// 费用类别字典
model expense_categories {
  id          String    @id @default(uuid())
  name        String
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}

// 采购内容字典
model purchase_contents {
  id          String    @id @default(uuid())
  name        String
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}

// 员工成本配置表
model employee_cost_config {
  id          String    @id @default(uuid())
  level_key   String
  level_name  String
  daily_cost  Decimal
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@unique([level_key], map: "uk_level")
}
