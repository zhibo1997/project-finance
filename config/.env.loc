# 非 VITE_ 开头的环境变量在使用 Vite 构建的页面中不生效，但是在 src/pages 外面都是可以正常用的
# 本地环境变量配置文件

# local sepc
IS_LOCAL=1

# 应用环境，与研发平台同步
ENV=LOC
PUBLIC_PATH=
BASE_PATH=
PREVIOUS_COMMITID=
PREVIOUS_TARGETURL=
QI_APP_CODE=
QI_APP_ID=
BUILD_GIT_BRANCH=

# APP 环境变量
VITE_ENV=LOC

# 参与者中心用户信息接口
VITE_ENN_USER_INFO_API=https://rdfa-gateway.dev.ennew.com/tenantManageApi/TenantManage/getLoginUserInfo
VITE_MDATA_ENN_USER_INFO_API=https://rdfa-gateway.dev.ennew.com/tenantManageApi/TenantManage/getLoginUserInfo